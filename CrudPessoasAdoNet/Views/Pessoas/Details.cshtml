@*
    =====================================================================
    VIEW — Details: mostra os DADOS de UMA pessoa (somente leitura)
    =====================================================================
*@

@model CrudPessoasAdoNet.Models.Pessoa

@{
    ViewData["Title"] = "Detalhes da Pessoa";
}

<h1>Detalhes da Pessoa</h1>
<hr />

@* <dl> = lista de definição: <dt> é o rótulo, <dd> é o valor. *@
<dl class="row">
    @* DisplayNameFor -> rótulo ([Display]); DisplayFor -> valor formatado. *@
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Idade)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Idade)</dd>
</dl>

<div>
    @* Model.Id = id da pessoa exibida, usado para montar /Pessoas/Edit/{id} *@
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
